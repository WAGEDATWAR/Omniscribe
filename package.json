{
  "name": "omniscribe",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A local-first web app that keeps tabletop RPG characters in one place.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test",
    "test:e2e": "node --no-warnings e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e",
    "a11y": "node --no-warnings e2e/a11y.mjs",
    "contrast": "node scripts/contrast.mjs",
    "deferrals": "node scripts/deferrals.mjs",
    "deferral-scan": "node scripts/deferral-scan.mjs",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format.mjs",
    "format:write": "node scripts/format.mjs --write",
    "bundle": "node scripts/bundle.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  }
}
