{
  "format": "omniscribe-system",
  "formatVersion": 1,
  "id": "dnd5e",
  "version": 1,
  "name": "D&D 5e",
  "system": "D&D 5e",
  "description": "The fifth edition character sheet: ability scores and modifiers, proficiency, saves, skills with expertise, hit points and hit dice, spell slots, spellcasting numbers, attacks and features. Structure and formulas only; no rules text. Derive your own house version from it.",
  "base": null,
  "overlay": [],
  "fields": [
    {
      "key": "race",
      "label": "Race or species",
      "type": "text"
    },
    {
      "key": "background_name",
      "label": "Background",
      "type": "text"
    },
    {
      "key": "alignment",
      "label": "Alignment",
      "type": "text"
    },
    {
      "key": "xp",
      "label": "Experience points",
      "type": "number",
      "default": 0,
      "min": 0
    },
    {
      "key": "level",
      "label": "Character level",
      "type": "derived",
      "formula": "sum(@classes.level)"
    },
    {
      "key": "proficiency",
      "label": "Proficiency bonus",
      "type": "derived",
      "formula": "2 + floor((@level - 1) / 4)",
      "format": "signed"
    },
    {
      "key": "str",
      "label": "Strength",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@str - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "dex",
      "label": "Dexterity",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@dex - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "con",
      "label": "Constitution",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@con - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "int",
      "label": "Intelligence",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@int - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "wis",
      "label": "Wisdom",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@wis - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "cha",
      "label": "Charisma",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@cha - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "save_prof_str",
      "label": "Strength save proficiency",
      "type": "flag"
    },
    {
      "key": "save_prof_dex",
      "label": "Dexterity save proficiency",
      "type": "flag"
    },
    {
      "key": "save_prof_con",
      "label": "Constitution save proficiency",
      "type": "flag"
    },
    {
      "key": "save_prof_int",
      "label": "Intelligence save proficiency",
      "type": "flag"
    },
    {
      "key": "save_prof_wis",
      "label": "Wisdom save proficiency",
      "type": "flag"
    },
    {
      "key": "save_prof_cha",
      "label": "Charisma save proficiency",
      "type": "flag"
    },
    {
      "key": "save_str",
      "label": "Strength save",
      "type": "derived",
      "formula": "@str.mod + if(@save_prof_str, @proficiency, 0)",
      "format": "signed"
    },
    {
      "key": "save_dex",
      "label": "Dexterity save",
      "type": "derived",
      "formula": "@dex.mod + if(@save_prof_dex, @proficiency, 0)",
      "format": "signed"
    },
    {
      "key": "save_con",
      "label": "Constitution save",
      "type": "derived",
      "formula": "@con.mod + if(@save_prof_con, @proficiency, 0)",
      "format": "signed"
    },
    {
      "key": "save_int",
      "label": "Intelligence save",
      "type": "derived",
      "formula": "@int.mod + if(@save_prof_int, @proficiency, 0)",
      "format": "signed"
    },
    {
      "key": "save_wis",
      "label": "Wisdom save",
      "type": "derived",
      "formula": "@wis.mod + if(@save_prof_wis, @proficiency, 0)",
      "format": "signed"
    },
    {
      "key": "save_cha",
      "label": "Charisma save",
      "type": "derived",
      "formula": "@cha.mod + if(@save_prof_cha, @proficiency, 0)",
      "format": "signed"
    },
    {
      "key": "ac",
      "label": "Armor class",
      "type": "number",
      "default": 10,
      "min": 0
    },
    {
      "key": "speed",
      "label": "Speed (ft)",
      "type": "number",
      "default": 30,
      "min": 0
    },
    {
      "key": "initiative_bonus",
      "label": "Initiative bonus",
      "type": "number",
      "default": 0
    },
    {
      "key": "initiative",
      "label": "Initiative",
      "type": "derived",
      "formula": "@dex.mod + @initiative_bonus",
      "format": "signed"
    },
    {
      "key": "passive_perception",
      "label": "Passive Perception",
      "type": "derived",
      "formula": "sum(@skills.total, $.name == \"Perception\") + 10"
    },
    {
      "key": "inspiration",
      "label": "Inspiration",
      "type": "flag"
    },
    {
      "key": "exhaustion",
      "label": "Exhaustion",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 6
    },
    {
      "key": "death_successes",
      "label": "Death save successes",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 3
    },
    {
      "key": "death_failures",
      "label": "Death save failures",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 3
    },
    {
      "key": "hp_max",
      "label": "Hit points (maximum)",
      "type": "number",
      "default": 1,
      "min": 1
    },
    {
      "key": "hit_die",
      "label": "Hit die",
      "type": "text",
      "default": "d8"
    },
    {
      "key": "spell_ability",
      "label": "Spellcasting ability",
      "type": "choice",
      "default": "none",
      "choices": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "str",
          "label": "Strength"
        },
        {
          "value": "dex",
          "label": "Dexterity"
        },
        {
          "value": "con",
          "label": "Constitution"
        },
        {
          "value": "int",
          "label": "Intelligence"
        },
        {
          "value": "wis",
          "label": "Wisdom"
        },
        {
          "value": "cha",
          "label": "Charisma"
        }
      ]
    },
    {
      "key": "spell_save_dc",
      "label": "Spell save DC",
      "type": "derived",
      "formula": "if(@spell_ability == \"none\", 0, 8 + @proficiency + if(@spell_ability == \"str\", @str.mod, if(@spell_ability == \"dex\", @dex.mod, if(@spell_ability == \"con\", @con.mod, if(@spell_ability == \"int\", @int.mod, if(@spell_ability == \"wis\", @wis.mod, if(@spell_ability == \"cha\", @cha.mod, 0)))))))"
    },
    {
      "key": "spell_attack",
      "label": "Spell attack bonus",
      "type": "derived",
      "formula": "if(@spell_ability == \"none\", 0, @proficiency + if(@spell_ability == \"str\", @str.mod, if(@spell_ability == \"dex\", @dex.mod, if(@spell_ability == \"con\", @con.mod, if(@spell_ability == \"int\", @int.mod, if(@spell_ability == \"wis\", @wis.mod, if(@spell_ability == \"cha\", @cha.mod, 0)))))))",
      "format": "signed"
    },
    {
