            {
              "value": "int",
              "label": "INT"
            },
            {
              "value": "wis",
              "label": "WIS"
            },
            {
              "value": "cha",
              "label": "CHA"
            }
          ]
        },
        {
          "key": "prof",
          "label": "Proficiency",
          "type": "choice",
          "default": "none",
          "choices": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "proficient",
              "label": "Proficient"
            },
            {
              "value": "expertise",
              "label": "Expertise"
            }
          ]
        },
        {
          "key": "total",
          "label": "Total",
          "type": "derived",
          "formula": "if($.ability == \"str\", @str.mod, if($.ability == \"dex\", @dex.mod, if($.ability == \"con\", @con.mod, if($.ability == \"int\", @int.mod, if($.ability == \"wis\", @wis.mod, if($.ability == \"cha\", @cha.mod, 0)))))) + if($.prof == \"expertise\", 2, if($.prof == \"proficient\", 1, 0)) * @proficiency",
          "format": "signed"
        }
      ]
    },
