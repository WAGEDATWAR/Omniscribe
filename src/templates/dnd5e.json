        },
        {
          "key": "ability",
          "label": "Ability",
          "type": "choice",
          "default": "wis",
          "choices": [
            {
              "value": "str",
              "label": "STR"
            },
            {
              "value": "dex",
              "label": "DEX"
            },
            {
              "value": "con",
              "label": "CON"
