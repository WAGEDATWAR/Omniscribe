        {
          "key": "ability_mod",
          "label": "Ability modifier",
          "type": "derived",
          "formula": "if($.ability == \"str\", @str.mod, if($.ability == \"dex\", @dex.mod, if($.ability == \"con\", @con.mod, if($.ability == \"int\", @int.mod, if($.ability == \"wis\", @wis.mod, if($.ability == \"cha\", @cha.mod, 0))))))",
          "format": "signed"
        },
