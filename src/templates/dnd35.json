        "mod": "floor((@con - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "int",
      "label": "Intelligence",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@int - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "wis",
      "label": "Wisdom",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@wis - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "cha",
      "label": "Charisma",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@cha - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "bab",
      "label": "Base attack bonus",
      "type": "derived",
      "formula": "sum(@classes.bab)",
      "format": "signed"
    },
    {
      "key": "attack_line",
      "label": "Attacks per round",
      "type": "derived",
      "formula": "concat(signed(@bab), if(@bab > 5, concat(\" / \", signed(@bab - 5)), \"\"), if(@bab > 10, concat(\" / \", signed(@bab - 10)), \"\"), if(@bab > 15, concat(\" / \", signed(@bab - 15)), \"\"))",
      "format": "text"
    },
    {
      "key": "size_mod",
      "label": "Size modifier",
      "type": "derived",
      "formula": "lookup(\"size_mod\", @size)",
      "format": "signed"
    },
    {
      "key": "grapple_size",
      "label": "Grapple size modifier",
      "type": "derived",
      "formula": "lookup(\"grapple_size\", @size)",
      "format": "signed"
    },
    {
      "key": "melee_attack",
      "label": "Melee attack",
      "type": "derived",
      "formula": "@bab + @str.mod + @size_mod",
      "format": "signed"
    },
    {
      "key": "ranged_attack",
      "label": "Ranged attack",
      "type": "derived",
      "formula": "@bab + @dex.mod + @size_mod",
      "format": "signed"
    },
    {
      "key": "grapple",
      "label": "Grapple",
      "type": "derived",
      "formula": "@bab + @str.mod + @grapple_size",
      "format": "signed"
    },
    {
      "key": "init_misc",
      "label": "Initiative misc",
      "type": "number",
      "default": 0
    },
    {
      "key": "initiative",
      "label": "Initiative",
      "type": "derived",
      "formula": "@dex.mod + @init_misc",
      "format": "signed"
    },
    {
      "key": "speed",
      "label": "Speed (ft)",
      "type": "number",
      "default": 30,
      "min": 0
    },
    {
      "key": "armor_bonus",
      "label": "Armor bonus",
      "type": "number",
      "default": 0
    },
    {
      "key": "shield_bonus",
      "label": "Shield bonus",
      "type": "number",
      "default": 0
    },
    {
      "key": "natural_armor",
      "label": "Natural armor",
      "type": "number",
      "default": 0
    },
    {
      "key": "deflection_bonus",
      "label": "Deflection bonus",
      "type": "number",
      "default": 0
    },
    {
      "key": "dodge_bonus",
      "label": "Dodge bonus",
      "type": "number",
      "default": 0
    },
    {
      "key": "ac_misc",
      "label": "AC misc",
      "type": "number",
      "default": 0
    },
    {
      "key": "ac",
      "label": "Armor class",
      "type": "derived",
      "formula": "10 + @armor_bonus + @shield_bonus + @dex.mod + @size_mod + @natural_armor + @deflection_bonus + @dodge_bonus + @ac_misc"
    },
    {
      "key": "touch_ac",
      "label": "Touch AC",
      "type": "derived",
      "formula": "10 + @dex.mod + @size_mod + @deflection_bonus + @dodge_bonus + @ac_misc"
    },
    {
      "key": "flat_footed_ac",
      "label": "Flat-footed AC",
      "type": "derived",
      "formula": "@ac - @dodge_bonus - max(@dex.mod, 0)"
    },
    {
      "key": "fort_misc",
      "label": "Fortitude misc",
      "type": "number",
      "default": 0
    },
    {
      "key": "ref_misc",
      "label": "Reflex misc",
      "type": "number",
      "default": 0
    },
    {
      "key": "will_misc",
      "label": "Will misc",
      "type": "number",
      "default": 0
    },
    {
      "key": "fort",
      "label": "Fortitude",
      "type": "derived",
      "formula": "sum(@classes.fort_base) + @con.mod + @fort_misc",
      "format": "signed"
    },
    {
      "key": "ref",
      "label": "Reflex",
      "type": "derived",
      "formula": "sum(@classes.ref_base) + @dex.mod + @ref_misc",
      "format": "signed"
    },
    {
      "key": "will",
      "label": "Will",
      "type": "derived",
      "formula": "sum(@classes.will_base) + @wis.mod + @will_misc",
      "format": "signed"
    },
    {
