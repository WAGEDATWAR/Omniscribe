      "key": "str",
      "label": "Strength",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
      "subs": {
        "mod": "floor((@str - 10) / 2)"
      },
      "subFormats": {
        "mod": "signed"
      }
    },
    {
      "key": "dex",
      "label": "Dexterity",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 99,
